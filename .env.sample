# Copy to .env and fill in. Values below are placeholders, never real secrets.

# --- Database (read-only role created by deploy/db/create_role.sql) ---
DB_HOST=db
DB_PORT=5432
DB_NAME=finance
DB_USER=my_finance_ai
DB_PASSWORD=change-me

# --- Secrets ---
# Must be the same Fernet key used by my-finance. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=change-me
AI_JWT_SECRET=change-me
GOOGLE_API_KEY=change-me

# --- Agent ---
AGENT_MODEL=change-me
AI_JWT_ISSUER=my-finance
AI_JWT_AUDIENCE=my-finance-ai
AGENT_MAX_LLM_CALLS=10
CHAT_TIMEOUT_SECONDS=60

# --- Sessions and limits ---
SESSION_TTL_MINUTES=30
MAX_SESSIONS_PER_USER=5
MAX_MESSAGE_CHARS=2000
RATE_LIMIT_PER_USER=30
DB_POOL_SIZE=5

# --- Observability ---
TRACING_ENABLED=false
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
